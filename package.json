{
  "name": "kybernesis",
  "private": true,
  "type": "module",
  "version": "1.4.0",
  "license": "MIT",
  "author": "David Moriarty",
  "homepage": "https://kybernesis.davidmoriarty.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidmoriarty/kybernesis.git"
  },
  "description": "A multi-tenant SaaS platform for software teams and individual developers, built with Bun, Hono, React, and TypeScript.",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "bun",
    "hono",
    "react",
    "vite",
    "tanstack-router",
    "drizzle",
    "postgresql",
    "monorepo",
    "turbo"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "scripts": {
    "prepare": "husky",
    "precommit": "lint-staged",
    "format": "biome check . --write",
    "lint": "biome check .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "build": "turbo build",
    "check": "bun run lint && bun run type-check && bun run build",
    "db:seed": "bun --cwd=packages/db run seed",
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=client",
    "dev:server": "turbo dev --filter=server --parallel",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server --parallel",
    "clean": "turbo clean"
  },
  "workspaces": [
    "./server",
    "./client",
    "./packages/shared",
    "./packages/db",
    "./packages/auth",
    "./packages/schemas"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "ts-prune": "^0.10.3",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  }
}
