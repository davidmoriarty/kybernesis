{
  "name": "kybernesis",
  "private": true,
  "types": "module",
  "version": "0.5.1",
  "license": "MIT",
  "author": "David Moriarty",
  "homepage": "https://kybernesis.davidmoriarty.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidmoriarty/kybernesis.git"
  },
  "description": "A multi-tenant SaaS platform for software teams and individual developers, built with Bun, Hono, React, and TypeScript.",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,yml,yaml}": "biome check --write"
  },
  "workspaces": [
    "./server",
    "./client",
    "./packages/shared",
    "./packages/db",
    "./packages/auth",
    "./packages/schemas"
  ],
  "keywords": [
    "bun",
    "hono",
    "react",
    "vite",
    "monorepo",
    "turbo"
  ],
  "scripts": {
    "prepare": "husky",
    "precommit": "lint-staged",
    "lint": "biome check .",
    "format": "biome check . --write",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:seed": "bun run packages/db/src/seed.ts",
    "dev": "turbo dev",
    "build": "turbo build",
    "dev:client": "turbo dev --filter=client",
    "dev:server": "turbo dev --filter=server --parallel",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server --parallel"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/bun": "^1.3.9",
    "bun-types": "^1.3.10",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "ts-prune": "^0.10.3",
    "turbo": "^2.7.2"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  }
}
