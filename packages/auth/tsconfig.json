    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "allowJs": false,
    "noEmit": false,
    "types": ["bun"]
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../shared" }, { "path": "../db" }],
  "exclude": ["node_modules", "dist"]
}
