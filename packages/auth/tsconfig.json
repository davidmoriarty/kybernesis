{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "allowJs": false,
    "noEmit": false
  },
  "include": ["src/**/*", "../shared/src/types/**/*.d.ts"],
  "references": [{ "path": "../shared" }, { "path": "../db" }],
  "exclude": ["node_modules", "dist"]
}
